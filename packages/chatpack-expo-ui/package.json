{
  "name": "chatpack-expo-ui",
  "version": "0.1.0",
  "description": "Native-feeling, fully customizable chat UI components for Expo / React Native. Backend-agnostic — works with chatpack-expo/@chatpack/client or any data source matching its ChatMessage shape.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@shopify/flash-list": ">=2",
    "expo-clipboard": ">=57",
    "expo-haptics": ">=57",
    "expo-image": ">=2",
    "expo-linear-gradient": ">=13",
    "expo-symbols": ">=57",
    "nativewind": ">=4",
    "react": ">=18",
    "react-native": "*",
    "react-native-gesture-handler": ">=2.20",
    "react-native-keyboard-controller": ">=1.21",
    "react-native-reanimated": ">=3",
    "react-native-safe-area-context": ">=4",
    "tailwindcss": ">3.3.0"
  },
  "peerDependenciesMeta": {
    "nativewind": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@shopify/flash-list": "2.0.2",
    "@types/react": "~19.2.2",
    "expo-clipboard": "~57.0.2",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linear-gradient": "~57.0.2",
    "expo-symbols": "~57.0.3",
    "nativewind": "^4.2.6",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-worklets": "0.10.1",
    "tailwindcss": "^3.4.15",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  }
}
