{
  "name": "chatpack-expo-ui",
  "version": "0.1.0",
  "description": "shadcn-inspired chat UI components for React Native/Expo. Backend-agnostic — works with chatpack-expo/@chatpack/client or any data source matching its ChatMessage shape.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@expo/ui": ">=57",
    "@expo/vector-icons": ">=14",
    "@shopify/flash-list": ">=2",
    "expo-image": ">=2",
    "expo-linear-gradient": ">=13",
    "nativewind": ">=4",
    "react": ">=18",
    "react-native": "*",
    "react-native-gesture-handler": ">=2",
    "react-native-reanimated": ">=3",
    "tailwindcss": ">3.3.0"
  },
  "peerDependenciesMeta": {
    "nativewind": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@expo/ui": "^57.0.13",
    "@expo/vector-icons": "^15.1.1",
    "@shopify/flash-list": "^2.2.3",
    "@types/react": "^19.2.13",
    "expo-image": "^57.0.3",
    "expo-linear-gradient": "^57.0.1",
    "nativewind": "^4.2.6",
    "react": "^19.2.3",
    "react-native": "^0.86.2",
    "react-native-gesture-handler": "^3.2.1",
    "react-native-reanimated": "^4.6.0",
    "react-native-worklets": "^0.12.1",
    "tailwindcss": "^3.4.15",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  }
}
