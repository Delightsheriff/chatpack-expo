{
  "name": "chatpack-expo",
  "version": "0.1.0",
  "description": "React Native / Expo transport adapter for @chatpack/client — SSE over XHR with Last-Event-ID resume, AppState-aware realtime lifecycle, bearer-token auth.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@chatpack/client": ">=0.8",
    "react": ">=18",
    "react-native": "*"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": false
    }
  },
  "devDependencies": {
    "@chatpack/client": "^0.8.1",
    "@types/react": "^19.2.13",
    "expo-linear-gradient": "^57.0.2",
    "react": "^19.2.8",
    "react-native": "^0.81.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  }
}
